{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/frontend/HomePage.html"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "api/index.py"
    },
    {
      "src": "^/uploads/(.*)$",
      "status": 404,
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
      "src": "^/(css|js|assets)/(.*)$",
      "dest": "/frontend/$1/$2"
    },
    {
      "src": "^/(.*\\.(css|js|png|jpg|jpeg|svg|ico|webp|woff|woff2|ttf|eot))$",
      "dest": "/frontend/$1"
    },
    {
      "src": "^/(.*\\.html)$",
      "dest": "/frontend/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/frontend/HomePage.html"
    }
  ]
}
