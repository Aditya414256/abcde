# MediFind — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Flask ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# development | production
FLASK_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Local development: leave unset (SQLite default is used)
# Production Supabase PostgreSQL (transaction pooler — for Vercel serverless):
#   DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# Migration (direct connection, NOT the pooler):
#   MIGRATION_DATABASE_URL=postgresql+psycopg2://postgres:<password>@<db-host>:5432/postgres?sslmode=require
#DATABASE_URL=
#MIGRATION_DATABASE_URL=

# ─── Supabase Storage (optional — for private prescription storage) ──────────
# Your Supabase project URL
#SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key — NEVER expose this to the browser
#SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Bucket names (must exist in Supabase Storage as private buckets)
#SUPABASE_PRESCRIPTIONS_BUCKET=prescriptions
#SUPABASE_PHARMACY_DOCS_BUCKET=pharmacy-docs

# ─── Uploads (local development only) ────────────────────────────────────────
# UPLOAD_FOLDER=uploads/prescriptions

# ─── PostgreSQL Concurrency Testing (local only) ─────────────────────────────
# MUST include "test" in the database name. MUST point to localhost.
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/medifind_test

