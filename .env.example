# MediFind — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Flask ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# development | production
FLASK_ENV=development

# ─── Supabase PostgreSQL Database ───────────────────────────────────────────
# Local development: leave unset (SQLite default is used)
# Production Supabase PostgreSQL (transaction pooler — for Vercel serverless):
#   DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Migration (session connection, port 5432):
#   MIGRATION_DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
#DATABASE_URL=
#MIGRATION_DATABASE_URL=

# ─── Supabase Storage ───────────────────────────────────────────────────────
# Your Supabase project URL:
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role / secret key — keep strictly server-side
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Bucket names (private buckets):
SUPABASE_PRESCRIPTIONS_BUCKET=prescriptions
SUPABASE_PHARMACY_DOCS_BUCKET=pharmacy-docs

# ─── Uploads (fallback for local development only) ──────────────────────────
# UPLOAD_FOLDER=uploads/prescriptions

# ─── PostgreSQL Concurrency Testing (local only) ─────────────────────────────
# MUST include "test" in the database name. MUST point to localhost.
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/medifind_test
